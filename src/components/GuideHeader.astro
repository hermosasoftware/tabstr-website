---
import { FOUNDER, SITE_NAME } from "../data/seo";

interface Props {
  category: string;
  date: string;
  datePublished: string;
  readingMinutes: number;
  headline: string;
  subtitle: string;
  image: string;
  imageAlt: string;
}

const { category, date, datePublished, readingMinutes, headline, subtitle, image, imageAlt } = Astro.props;
---

<header class="mb-10">
  <p class="block-subtitle mb-4">{category}</p>
  <h1 class="text-4xl sm:text-5xl font-bold text-primaryText mb-6">{headline}</h1>
  <p class="text-lg text-secondaryText leading-relaxed mb-4">{subtitle}</p>
  <p class="text-sm text-secondaryText mb-8">
    Por {FOUNDER.name}, {FOUNDER.jobTitle} de {SITE_NAME} ·
    <time datetime={datePublished}>{date}</time>
    · {readingMinutes} min de lectura
  </p>
  <img
    src={image}
    alt={imageAlt}
    class="w-full h-auto rounded-3xl border border-solid border-mainBorder"
    width="1200"
    height="675"
  />
</header>
