---
import Layout from '../../layouts/Layout.astro'
import { Navbar } from '../../components/Navbar.tsx'
import { Footer } from '../../components/Footer.jsx'
import { ScrollUpButton } from '../../components/ScrollUpButton'
import BlogCard from '../../components/BlogCard.astro'
import '../../styles/Theme.css'
import { blogData } from '../../data/blogData'
import { absoluteUrl } from '../../data/seo'

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog de Tabstr POS',
  description:
    'Guías de Tabstr POS para restaurantes y sodas en Costa Rica: IVA, servicio del 10%, CABYS, SINPE, food cost y migración.',
  url: absoluteUrl('/blog/'),
  inLanguage: 'es-CR',
  blogPost: blogData.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.subtitle,
    url: absoluteUrl(post.href),
    datePublished: post.datePublished,
    image: post.image.startsWith('http') ? post.image : absoluteUrl(post.image),
  })),
}
---

<Layout
  title="Blog Tabstr POS Costa Rica | Guías de IVA, SINPE y migración"
  description="Guías de Tabstr para restaurantes y sodas en Costa Rica: servicio del 10% e IVA, CABYS, food cost, SINPE Móvil y cómo dejar un POS por dispositivo."
  canonicalPath="/blog/"
  jsonLd={blogSchema}
>
  <Navbar client:load />
  
  <div class="relative overflow-hidden w-full bg-bgDark2 pt-32 pb-16">
    <div class="brand-glow w-[40rem] h-[24rem] left-1/2 -ml-[20rem] -top-48 opacity-60" aria-hidden="true"></div>
    <div class="relative mx-auto w-11/12 max-w-6xl">
      <div class="text-center mb-16">
        <span class="block-subtitle">Blog</span>
        <h1 class="mt-6 mb-6 block-big-title lg:text-6xl">
          Últimas publicaciones
        </h1>
        <p class="text-lg text-secondaryText max-w-2xl mx-auto">
          Guías para restaurantes, bares, cafés y sodas en Costa Rica: factura 4.4,
          servicio del 10%, CABYS, food cost, SINPE y el costo real de un POS por dispositivo.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
        {blogData.map((post, index) => (
          <BlogCard post={post} headingLevel="h2" revealDelay={index * 100} />
        ))}
      </div>
    </div>
  </div>

  <Footer />
  <ScrollUpButton client:load />
</Layout>
