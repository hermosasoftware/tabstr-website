---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Industries from "../components/Industries.astro";
import { Navbar } from "../components/Navbar.tsx";
import Clients from "../components/Clients.astro";
import DeviceShowcase from "../components/DeviceShowcase.astro";
import BentoFeatures from "../components/BentoFeatures.astro";
import AiSection from "../components/AiSection.astro";
import StatsBand from "../components/StatsBand.astro";
import Testimonials from "../components/Testimonials.astro";
import Blog from "../components/Blog.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { Contact } from "../components/Contact.jsx";
import { Footer } from "../components/Footer.jsx";
import { ScrollUpButton } from "../components/ScrollUpButton";
import FaqSection from "../components/FaqSection.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import AudienceFit from "../components/AudienceFit.astro";
import RelatedPages from "../components/RelatedPages.astro";
import {
  ENTITY_SENTENCE,
  HOME_DESCRIPTION,
  HOME_TITLE,
  faqPageSchema,
  organizationSchema,
  softwareSchema,
} from "../data/seo";
import { FAQ_ITEMS } from "../data/faq";
---

<Layout
  title={HOME_TITLE}
  description={HOME_DESCRIPTION}
  canonicalPath="/"
  jsonLd={[
    organizationSchema(),
    softwareSchema(),
    faqPageSchema(FAQ_ITEMS),
  ]}
>
  <Navbar client:load />
  <Hero />
  <Clients />
  <Industries />
  <DeviceShowcase />
  <BentoFeatures />
  <AiSection />
  <StatsBand />
  <Testimonials />
  <section class="w-full bg-bgDark2 py-8">
    <div class="container mx-auto px-4 w-11/12 md:w-10/12 xl:w-4/5 2xl:w-2/3 max-w-5xl">
      <p class="text-secondaryText leading-relaxed text-lg mb-6">{ENTITY_SENTENCE}</p>
      <h2 class="text-2xl font-bold text-primaryText mb-4">Qué es Tabstr y en qué se diferencia</h2>
      <p class="text-secondaryText leading-relaxed mb-4">
        Tabstr es un POS moderno para restaurantes y bares en Costa Rica, y también para retail,
        minisupers y licoreras. El precio no sube cada vez que encendés otra pantalla. Estas son
        las piezas que el local usa en el mismo sistema:
      </p>
      <ul class="list-disc pl-6 text-secondaryText leading-relaxed space-y-2 mb-8">
        <li>Sin licencia por dispositivo: caja, cocina, barra y el celular del dueño.</li>
        <li>Corre en celular, tablet o computadora. Android, iOS, Windows, macOS y Linux.</li>
        <li>Facturación electrónica Hacienda 4.4 nativa, sin GTI ni una segunda app.</li>
        <li>SINPE móvil registrado en la venta, con el comprobante en la cuenta.</li>
        <li>Pagos con Bitcoin, junto a efectivo, tarjeta y SINPE.</li>
        <li>Sugerencias de stock con IA, según tus ventas y fechas como Semana Santa o Navidad.</li>
        <li>Asistencia del personal con reconocimiento facial y reporte de horas.</li>
        <li>Sigue vendiendo si se va el internet y sincroniza cuando vuelve la red.</li>
        <li>Migración del catálogo por Excel y capacitación incluida. El primer mes es gratis.</li>
        <li>Integración con Shopify si tenés tienda física y tienda en línea.</li>
      </ul>
      <p class="text-secondaryText leading-relaxed mb-8">
        El detalle de mesas y cocina está en
        <a href="/pos-para-restaurantes/" class="text-secondaryColor hover:underline">POS para restaurantes</a>.
        Retail, minisupers, licoreras y Shopify están en
        <a href="/pos-para-comercios/" class="text-secondaryColor hover:underline">POS para comercios</a>.
        Cómo se arma el 10% de servicio y el IVA está en
        <a href="/blog/servicio-10-iva-factura-electronica-4-4/" class="text-secondaryColor hover:underline">la guía de factura 4.4</a>.
        Por qué el cobro por pantalla ya no cierra está en
        <a href="/blog/pos-sin-licencia-por-dispositivo/" class="text-secondaryColor hover:underline">POS sin licencia por dispositivo</a>.
      </p>
      <ComparisonTable />
      <AudienceFit />
      <RelatedPages />
    </div>
  </section>
  <Blog />
  <FaqSection />
  <section class="w-full bg-bgDark2 pb-8">
    <div class="mx-auto w-11/12 max-w-6xl">
      <CtaBanner
        title="Probalo un mes gratis en tu local"
        body="Operá de verdad durante 30 días: caja, Hacienda 4.4 y tu equipo usando Tabstr en los dispositivos que ya tenés. Si encaja, seguís. Si no, no te amarramos."
        label="Empezar mi mes gratis"
      />
    </div>
  </section>
  <Contact client:load />
  <Footer />
  <ScrollUpButton client:load />
</Layout>
